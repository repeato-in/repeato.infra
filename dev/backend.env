# Settings of the backend on this laptop, read by dev/up.ps1 and by the backend's VS Code launch "Backend: local" (envFile). Local MySQL repeato-mysql-dev only, SMS off, OTP bypass, the backend's own fakes for payments, storage, email and push, schedulers off. No secrets: every value here is a local placeholder.
SKIP_DOTENV=true
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_HOST_PORT=3308
DB_NAME=repeato_dev_local
DB_USERNAME=root
DB_PASSWORD=repeato-local-root
DB_DIALECT=mysql
DB_SOCKET_PATH=
JWT_SECRET=local-dev-jwt-secret
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=local-dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=604800
REDIS_DISABLED=true
MESSAGING_ENABLED=false
NOTIFICATIONS_ENABLED=false
OTP_BYPASS=true
TEST_MODE=true
USE_LOCAL_STORAGE=true
GCS_KEY_FILE=
GCS_ENV_PREFIX=dev
BACKEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
APP_WEB_BASE_URL=http://localhost:5176
CONSOLE_URL=http://localhost:5174
APP_DEEP_LINK_SCHEME=repeato
APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.repeato.app
APP_IOS_STORE_URL=https://apps.apple.com/app/repeato/id123456789
CORS_ORIGIN=http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:56617,http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_local
RAZORPAY_KEY_SECRET=local-fake-secret
RAZORPAY_WEBHOOK_SECRET=local-fake-webhook
PRIMARY_MESSAGING_PROVIDER=authkey
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
SCHEDULER_TIMEZONE=Asia/Kolkata
BACKGROUND_JOB_CLEANUP_ENABLED=false
DISABLE_SCHEDULERS=true
